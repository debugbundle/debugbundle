{
  "mcpServers": {
    "debugbundle": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@debugbundle/mcp@1.12.1",
        "--local-auth"
      ],
      "env": {
        "DEBUGBUNDLE_MEMBER_TOKEN": "${user_config.member_token}",
        "DEBUGBUNDLE_API_URL": "${user_config.api_url}"
      }
    }
  }
}
