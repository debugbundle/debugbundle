{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "captured_at",
    "generated_at",
    "retained_event_count",
    "trace_origin",
    "exception_node_count",
    "recovery",
    "passive_observation_count",
    "unavailable_status_count",
    "facts",
    "possible_causes",
    "importance",
    "next_evidence"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "unavailable",
        "legacy",
        "partial",
        "observed"
      ]
    },
    "captured_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/dateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "generated_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/dateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "retained_event_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "trace_origin": {
      "enum": [
        "throw",
        "native_fatal",
        "capture",
        "runtime_reported",
        "unavailable",
        "unknown",
        null
      ]
    },
    "exception_node_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 8
    },
    "recovery": {
      "enum": [
        "unknown",
        "recovered",
        "persisted",
        "conflicting"
      ]
    },
    "passive_observation_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "unavailable_status_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "facts": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "possible_causes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "importance": {
      "type": "string",
      "maxLength": 512
    },
    "next_evidence": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    }
  }
}
