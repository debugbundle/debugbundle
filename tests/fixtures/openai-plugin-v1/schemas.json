        "device_types": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/analyticsSegment" } },
        "browsers": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/analyticsSegment" } },
        "os": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/analyticsSegment" } },
        "languages": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/analyticsSegment" } },
        "referrers": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/analyticsSegment" } },
        "auth_states": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/analyticsSegment" } }
      }
