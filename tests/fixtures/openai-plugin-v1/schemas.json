        "event_count": { "type": "integer", "minimum": 0 }, "unique_sessions": { "type": "integer", "minimum": 0 }
      }
    },
    "analyticsFunnelMetric": {
      "type": "object", "additionalProperties": false,
      "required": ["funnel_key", "sessions_entered", "sessions_completed", "dropoffs", "conversion_rate"],
      "properties": {
        "funnel_key": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sessions_entered": { "type": "integer", "minimum": 0 }, "sessions_completed": { "type": "integer", "minimum": 0 },
        "dropoffs": { "type": "integer", "minimum": 0 }, "conversion_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "analyticsFunnelStep": {
      "type": "object", "additionalProperties": false,
      "required": ["step_key", "step_order", "sessions_entered", "sessions_completed", "dropoffs", "conversion_rate"],
      "properties": {
        "step_key": { "type": "string", "minLength": 1, "maxLength": 120 }, "step_order": { "type": "integer", "minimum": 0 },
        "sessions_entered": { "type": "integer", "minimum": 0 }, "sessions_completed": { "type": "integer", "minimum": 0 },
        "dropoffs": { "type": "integer", "minimum": 0 }, "conversion_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "analyticsFunnelSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "funnel_key", "from", "to", "granularity", "service", "environment", "sessions_entered", "sessions_completed", "dropoffs", "conversion_rate"],
      "properties": {
        "project_id": { "$ref": "#/$defs/id" }, "funnel_key": { "type": "string", "minLength": 1, "maxLength": 120 },
        "from": { "$ref": "#/$defs/dateTime" }, "to": { "$ref": "#/$defs/dateTime" }, "granularity": { "enum": ["hour", "day"] },
        "service": { "type": ["string", "null"], "maxLength": 120 }, "environment": { "type": ["string", "null"], "maxLength": 120 },
        "sessions_entered": { "type": "integer", "minimum": 0 }, "sessions_completed": { "type": "integer", "minimum": 0 },
        "dropoffs": { "type": "integer", "minimum": 0 }, "conversion_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "analyticsImpactSegment": {
      "type": "object", "additionalProperties": false, "required": ["value", "affected_sessions"],
      "properties": { "value": { "type": "string", "minLength": 1, "maxLength": 255 }, "affected_sessions": { "type": "integer", "minimum": 0 } }
    },
    "analyticsImpactRoute": {
      "type": "object", "additionalProperties": false, "required": ["route_key", "affected_sessions"],
