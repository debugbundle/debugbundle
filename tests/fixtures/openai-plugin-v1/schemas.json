    "analyticsRouteMetric": {
      "type": "object", "additionalProperties": false,
      "required": ["route_key", "pageviews", "unique_sessions", "entrances", "exits", "bounces", "linked_incident_sessions"],
      "properties": {
        "route_key": { "type": "string", "minLength": 1, "maxLength": 2048 },
