DATABASE_URL=postgresql://debugbundle:debugbundle@localhost:5434/debugbundle
REDIS_URL=redis://localhost:6380
S3_ENDPOINT=http://localhost:4567
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=debugbundle
S3_REGION=us-east-1
API_PORT=3003
API_HOST=0.0.0.0
# Explicit immediate proxy IPs only; empty ignores all forwarding headers.
# Set only where the managed proxy overwrites untrusted X-Forwarded-* headers.
API_TRUSTED_PROXY_IPS=
WORKER_CONCURRENCY=5
TOKEN_SECRET=replace-with-a-random-secret
SES_REGION=us-east-1
SES_FROM_EMAIL=noreply@debugbundle.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SOLO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
STRIPE_SOLO_EXTRA_CAPACITY_PRICE_ID=
STRIPE_TEAM_EXTRA_CAPACITY_PRICE_ID=
# Optional catalogue additions; leave blank until exact provider prices are approved.
# New Business purchases also require enabled, configured Smart Reports/AI.
BUSINESS_SALES_ENABLED=false
# Optional programme coupon: exactly 10%, once, Business base products only.
STRIPE_BUSINESS_REFERRAL_COUPON_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_BUSINESS_EXTRA_CAPACITY_PRICE_ID=
STRIPE_SOLO_ANNUAL_PRICE_ID=
STRIPE_TEAM_ANNUAL_PRICE_ID=
STRIPE_BUSINESS_ANNUAL_PRICE_ID=
STRIPE_SOLO_EXTRA_CAPACITY_ANNUAL_PRICE_ID=
STRIPE_TEAM_EXTRA_CAPACITY_ANNUAL_PRICE_ID=
STRIPE_BUSINESS_EXTRA_CAPACITY_ANNUAL_PRICE_ID=
STRIPE_TEAM_EXTRA_CAPACITY_CURRENT_PRICE_ID=

# Legacy local-only billing link fallback. Hosted deploys should leave these unset
# and rely on dynamic Stripe sessions configured through the hosted deploy workflow.
# Legacy static billing links are local/manual only; ignored with NODE_ENV=production.
STRIPE_SOLO_CHECKOUT_URL=
STRIPE_TEAM_CHECKOUT_URL=
STRIPE_CUSTOMER_PORTAL_URL=
VITE_API_URL=http://localhost:3003
APP_BASE_URL=http://localhost:5291
# Optional Business referral programme. Missing/invalid secret disables the
# service, independently of login/debugging. Keep the dedicated secret stable:
# it signs pending links and protects retained payment-identity hashes.
# Existing internal operator allowlist; workspace roles do not grant payout access.
BILLING_ADMIN_OVERRIDE_EMAILS=
REFERRAL_SECRET=
REFERRAL_ENROLLMENT_ENABLED=false
REFERRAL_API_BASE_URL=http://localhost:3003
REFERRAL_LANDING_URL=http://localhost:5291
# New report generation and email egress stay disabled until release configuration is ready.
# Authorised archive/PDF reads and maintenance remain available. Email uses existing
# SES and APP_BASE_URL settings; missing mail configuration never blocks debugging.
# Use the same server-only report configuration for API and worker. AI is optional;
# missing/invalid configuration produces an explicitly factual report. Hosted AI
# budgets cannot exceed one USD (1,000,000,000 nanodollars) per monthly window.
SMART_REPORTS_ENABLED=false
SMART_REPORT_AI_ENABLED=false
SMART_REPORT_AI_API_KEY=
SMART_REPORT_AI_MONTHLY_BUDGET_NANO_USD=1000000000
# Optional; default share links use APP_BASE_URL/status/<public-id>.
# For a dedicated status host, set both values to its root and serve the same SPA there.
PUBLIC_STATUS_PAGE_BASE_URL=
VITE_PUBLIC_STATUS_PAGE_BASE_URL=
# Enable only behind a trusted private reverse proxy that appends X-Forwarded-For.
PUBLIC_STATUS_TRUST_PROXY=false
# Optional public origin for email images when APP_BASE_URL is local-only.
EMAIL_ASSET_BASE_URL=
DEBUGBUNDLE_DOGFOOD_ENABLED=
DEBUGBUNDLE_DOGFOOD_PROJECT_TOKEN=
DEBUGBUNDLE_DOGFOOD_EXPOSE_TRIGGERS=false
DEBUGBUNDLE_DOGFOOD_SERVICE=debugbundle-api
DEBUGBUNDLE_DOGFOOD_ENVIRONMENT=development
VITE_DEBUGBUNDLE_DOGFOOD_ENABLED=
VITE_DEBUGBUNDLE_DOGFOOD_PROJECT_TOKEN=
VITE_DEBUGBUNDLE_DOGFOOD_EXPOSE_TRIGGERS=false
VITE_DEBUGBUNDLE_DOGFOOD_SERVICE=debugbundle-web
VITE_DEBUGBUNDLE_DOGFOOD_ENVIRONMENT=development
VITE_DEBUGBUNDLE_DOGFOOD_ANALYTICS_ENABLED=false
# Headless startup for our own app; requires analytics enabled and respects device opt-out.
VITE_DEBUGBUNDLE_DOGFOOD_ANALYTICS_AUTO_START=false
# Optional public flow consumer; use a write-only token restricted to the participating origins.
VITE_DEBUGBUNDLE_FLOW_PROJECT_ID=
VITE_DEBUGBUNDLE_FLOW_PROJECT_TOKEN=
AUTH_COOKIE_SECURE=false
AUTH_SIGNUP_ALLOWED_EMAILS=owner@example.com,admin@example.com
ADMIN_ANALYTICS_ACCESS_EMAILS=owner@example.com
DEV_GITHUB_MOCK_LOGIN=false
DEV_GITHUB_MOCK_EMAIL=dev@debugbundle.local
DEBUGBUNDLE_PROBE_TRIGGER_SECRET=replace-with-a-long-random-secret
ANALYTICS_HASH_SECRET=replace-with-a-long-random-secret
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5291/v1/auth/github/callback
GITHUB_OAUTH_STATE_SECRET=replace-with-a-random-secret
REVIEW_ACCESS_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_CALLBACK_URL=https://YOUR-TUNNEL.ngrok-free.app/v1/slack/app/callback
SLACK_OAUTH_STATE_SECRET=replace-with-a-random-secret
SLACK_SIGNING_SECRET=
INTEGRATION_SECRET_ENCRYPTION_KEY=replace-with-a-32-byte-random-secret
NODE_ENV=development

# Enable only after agent-token migration and all serving API replicas are upgraded.
AGENT_TOKEN_ISSUANCE_ENABLED=false
# Enable only after compatible API/worker, rollback and SDK-cache qualification.
PROJECT_MERGES_ENABLED=false
