{
  "name": "debugbundle",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "description": "DebugBundle monorepo",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-chunked-coverage.mjs",
    "coverage:changed": "node scripts/check-changed-file-coverage.mjs",
    "build": "tsc --noEmit -p tsconfig.json",
    "cli:start": "pnpm --filter @debugbundle/cli start",
    "mcp:start": "pnpm --filter @debugbundle/mcp start",
    "mcp:ecosystem:plan": "node scripts/release-mcp-ecosystem.mjs plan",
    "mcp:ecosystem:prepare": "node scripts/release-mcp-ecosystem.mjs prepare",
    "mcp:ecosystem:publish": "node scripts/release-mcp-ecosystem.mjs publish",
    "mcp:ecosystem:verify": "node scripts/release-mcp-ecosystem.mjs verify",
    "mcp:ecosystem:run": "node scripts/release-mcp-ecosystem.mjs run",
    "public-site:artifacts": "tsx scripts/public-site-artifacts.ts",
    "public-site:dev": "tsx scripts/public-site-artifacts.ts && pnpm --dir ./site dev",
    "public-site:build": "tsx scripts/public-site-artifacts.ts && pnpm --dir ./site build",
    "public-site:typecheck": "pnpm --dir ./site typecheck",
    "turbo:lint": "turbo run lint",
    "turbo:typecheck": "turbo run typecheck",
    "turbo:test": "turbo run test",
    "turbo:build": "turbo run build",
    "db:bootstrap": "tsx scripts/bootstrap-storage.ts",
    "db:backfill-account-analytics": "tsx scripts/backfill-account-analytics.ts",
    "db:migrate": "tsx scripts/migrate-storage.ts",
    "api:start": "tsx apps/api/src/main.ts",
    "api:check": "vitest run tests/apps/api/api-runtime.test.ts tests/apps/api/api-runtime-start.test.ts tests/apps/api/api-dogfooding.test.ts",
    "worker:start": "tsx apps/worker/src/main.ts",
    "worker:check": "vitest run tests/apps/worker/worker-runtime.test.ts tests/apps/worker/worker-processor-normalize.test.ts tests/apps/worker/worker-processor-group-incident.test.ts tests/apps/worker/worker-processor-bundle-delivery.test.ts tests/apps/worker/worker-weekly-reporting.test.ts"
  },
  "devDependencies": {
    "@debugbundle/cli": "workspace:*",
    "@debugbundle/mcp": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-istanbul": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "istanbul-lib-coverage": "^3.2.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.5",
    "turbo": "^2.9.4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1024.0",
    "@aws-sdk/client-sesv2": "^3.1024.0",
    "@debugbundle/auth": "workspace:*",
    "@debugbundle/redaction": "1.5.0",
    "@debugbundle/sdk-node": "1.5.0",
    "@debugbundle/shared-types": "1.5.0",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.8.4",
    "ioredis": "^5.10.1",
    "pino": "^9.7.0",
    "pg": "^8.13.3",
    "stripe": "^22.0.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "main": "index.js",
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debugbundle/debugbundle.git"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/debugbundle/debugbundle/issues"
  },
  "homepage": "https://github.com/debugbundle/debugbundle#readme"
}
