{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "listReportsInput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    },
    "listReportsOutput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "reports": {
          "maxItems": 25,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "status": {
                "type": "string",
                "enum": [
                  "queued",
                  "processing",
                  "ready",
                  "factual_only",
                  "failed",
                  "skipped_quota",
                  "paused_access",
                  "cancelled",
                  "expired"
                ]
              },
              "privacy_mode": {
                "type": "string",
                "enum": ["full", "restricted"]
              },
              "period": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["daily", "weekly", "monthly"]
                  },
                  "starts_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  "ends_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  "duration_days": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31
                  }
                },
                "required": ["kind", "starts_at", "ends_at", "duration_days"],
                "additionalProperties": false
              },
              "created_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "published_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "expires_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "project_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            },
            "required": [
              "id",
              "name",
              "status",
              "privacy_mode",
              "period",
              "created_at",
              "published_at",
              "expires_at",
              "project_count"
            ],
            "additionalProperties": false
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["reports", "next_cursor"],
      "additionalProperties": false
    },
    "getReportContentInput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": ["reportId"],
      "additionalProperties": false
    },
    "getReportContentOutput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "report": {
          "type": "object",
          "properties": {
            "report_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "expires_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "facts": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "number",
                  "const": 1
                },
                "period": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": ["daily", "weekly", "monthly"]
                    },
                    "starts_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "ends_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "duration_days": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 31
                    }
                  },
                  "required": ["kind", "starts_at", "ends_at", "duration_days"],
                  "additionalProperties": false
                },
                "previous_period": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": ["daily", "weekly", "monthly"]
                    },
                    "starts_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "ends_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "duration_days": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 31
                    }
                  },
                  "required": ["kind", "starts_at", "ends_at", "duration_days"],
                  "additionalProperties": false
                },
                "cutoff_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "privacy_mode": {
                  "type": "string",
                  "enum": ["full", "restricted"]
                },
                "projects": {
                  "minItems": 1,
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ref": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "coverage_ref": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                      },
                      "coverage": {
                        "type": "object",
                        "properties": {
                          "lifecycle": {
                            "type": "string",
                            "enum": ["complete", "partial", "unavailable"]
                          },
                          "availability": {
                            "type": "string",
                            "enum": ["complete", "partial", "unavailable"]
                          },
                          "analytics": {
                            "type": "string",
                            "enum": ["complete", "partial", "unavailable"]
                          }
                        },
                        "required": ["lifecycle", "availability", "analytics"],
                        "additionalProperties": false
                      },
                      "notes": {
                        "maxItems": 8,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 300
                        }
                      }
                    },
                    "required": ["ref", "name", "coverage_ref", "coverage", "notes"],
                    "additionalProperties": false
                  }
                },
                "metrics": {
                  "maxItems": 200,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ref": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                      },
                      "project_ref": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                      },
                      "key": {
                        "type": "string",
                        "enum": [
                          "new_incidents",
                          "resolution_events",
                          "distinct_resolved_incidents",
                          "regressions",
                          "new_improvements",
                          "resolved_improvements",
                          "open_high_incidents",
                          "open_critical_incidents",
                          "successful_checks",
                          "total_checks",
                          "estimated_check_downtime_seconds",
                          "analytics_sessions",
                          "analytics_events",
                          "analytics_page_views",
                          "daily_active_visitor_days"
                        ]
                      },
                      "current": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1000000000000
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "previous": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1000000000000
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "unit": {
                        "type": "string",
                        "enum": ["count", "seconds", "visitor_days"]
                      },
                      "current_complete": {
                        "type": "boolean"
                      },
                      "previous_complete": {
                        "type": "boolean"
                      },
                      "notes": {
                        "maxItems": 4,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 300
                        }
                      },
                      "comparison": {
                        "type": "object",
                        "properties": {
                          "comparison_available": {
                            "type": "boolean"
                          },
                          "absolute_change": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "percent_change": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "current_per_day": {
                            "anyOf": [
                              {
                                "type": "number",
                                "minimum": 0
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "previous_per_day": {
                            "anyOf": [
                              {
                                "type": "number",
                                "minimum": 0
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "unequal_period_lengths": {
                            "type": "boolean"
                          },
                          "rate_direction": {
                            "type": "string",
                            "enum": ["increased", "decreased", "unchanged", "unavailable"]
                          },
                          "metric_semantics": {
                            "type": "string",
                            "enum": ["period_total", "snapshot"]
                          },
                          "value_direction": {
                            "type": "string",
                            "enum": ["increased", "decreased", "unchanged", "unavailable"]
                          }
                        },
                        "required": [
                          "comparison_available",
                          "absolute_change",
                          "percent_change",
                          "current_per_day",
                          "previous_per_day",
                          "unequal_period_lengths",
                          "rate_direction"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "ref",
                      "project_ref",
                      "key",
                      "current",
                      "previous",
                      "unit",
                      "current_complete",
                      "previous_complete",
                      "notes"
                    ],
                    "additionalProperties": false
                  }
                },
                "evidence": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ref": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                      },
                      "project_ref": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                      },
                      "type": {
                        "type": "string",
                        "enum": ["incident", "improvement", "health"]
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "open",
                          "resolved",
                          "regressed",
                          "snoozed",
                          "dismissed",
                          "observed_recovery"
                        ]
                      },
                      "severity": {
                        "type": "string",
                        "enum": ["critical", "high", "medium", "low", "unknown"]
                      },
                      "period_events": {
                        "maxItems": 5,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["new", "resolved", "regressed", "reopened", "observed_recovery"]
                        }
                      },
                      "first_seen_at": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "last_seen_at": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "context": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 1600
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "ref",
                      "project_ref",
                      "type",
                      "status",
                      "severity",
                      "period_events",
                      "first_seen_at",
                      "last_seen_at",
                      "title",
                      "context"
                    ],
                    "additionalProperties": false
                  }
                },
                "selection_notes": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 300
                  }
                }
              },
              "required": [
                "version",
                "period",
                "previous_period",
                "cutoff_at",
                "privacy_mode",
                "projects",
                "metrics",
                "evidence",
                "selection_notes"
              ],
              "additionalProperties": false
            },
            "narrative": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "number",
                      "const": 1
                    },
                    "overview": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 700
                        },
                        "evidence_refs": {
                          "minItems": 1,
                          "maxItems": 10,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]{0,63}$"
                          }
                        }
                      },
                      "required": ["text", "evidence_refs"],
                      "additionalProperties": false
                    },
                    "highlights": {
                      "maxItems": 10,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 700
                          },
                          "evidence_refs": {
                            "minItems": 1,
                            "maxItems": 10,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_]{0,63}$"
                            }
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "happened",
                              "recorded_resolution",
                              "observed_recovery",
                              "outstanding",
                              "inference"
                            ]
                          }
                        },
                        "required": ["text", "evidence_refs", "kind"],
                        "additionalProperties": false
                      }
                    },
                    "priorities": {
                      "maxItems": 10,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "action": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                          },
                          "rationale": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 400
                          },
                          "evidence_refs": {
                            "minItems": 1,
                            "maxItems": 10,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_]{0,63}$"
                            }
                          }
                        },
                        "required": ["title", "action", "rationale", "evidence_refs"],
                        "additionalProperties": false
                      }
                    },
                    "limitations": {
                      "maxItems": 10,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 700
                          },
                          "evidence_refs": {
                            "minItems": 1,
                            "maxItems": 10,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_]{0,63}$"
                            }
                          }
                        },
                        "required": ["text", "evidence_refs"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["version", "overview", "highlights", "priorities", "limitations"],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "analysis": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": ["available", "unavailable"]
                },
                "reason": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "model_unavailable",
                        "input_limit",
                        "preflight_unavailable",
                        "model_rejected",
                        "model_uncertain",
                        "saved_response_unavailable"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "model": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": ["gpt-6-luna", "gpt-6.1-terra"]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["status", "reason", "model"],
              "additionalProperties": false
            }
          },
          "required": ["report_id", "name", "expires_at", "facts", "narrative", "analysis"],
          "additionalProperties": false
        }
      },
      "required": ["report"],
      "additionalProperties": false
    }
  }
}
