# Core self-host mode
SELFHOST_MODE=true
CONTAINER_PREFIX=debugbundle-selfhost

# Public URLs and exposed ports
APP_BASE_URL=http://localhost:5291
API_PORT=3004
WEB_PORT=5291
POSTGRES_PORT=5434
REDIS_PORT=6380
LOCALSTACK_PORT=4567

# Database and object storage
POSTGRES_USER=debugbundle
POSTGRES_PASSWORD=debugbundle
POSTGRES_DB=debugbundle
S3_REGION=us-east-1
S3_BUCKET=debugbundle-raw-events

# Required runtime secrets
DEBUGBUNDLE_PROBE_TRIGGER_SECRET=replace-with-a-long-random-secret
ANALYTICS_HASH_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_SECURE=false

# Web runtime
VITE_API_URL=http://localhost:3004

# Worker tuning
WORKER_POLL_INTERVAL_MS=1000
WORKER_HEALTH_PORT=3001
WORKER_RUN_ONCE=0

# Optional GitHub OAuth for browser sign-in
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3004/v1/auth/github/callback
GITHUB_OAUTH_STATE_SECRET=
DEV_GITHUB_MOCK_LOGIN=false
DEV_GITHUB_MOCK_EMAIL=dev@debugbundle.local

# Optional GitHub App automation
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_MARKETPLACE_WEBHOOK_SECRET=
